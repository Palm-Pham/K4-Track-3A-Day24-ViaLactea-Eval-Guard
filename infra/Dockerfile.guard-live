FROM python:3.11-slim

# Linux build tools compile Annoy without installing MSVC on the Windows host.
RUN apt-get update && apt-get install -y --no-install-recommends build-essential
RUN python -m pip install --no-cache-dir \
    "nemoguardrails[openai]==0.10.0" "annoy==1.17.3" \
    "langchain==0.2.17" "langchain-core==0.2.43" \
    "langchain-community==0.2.19" "langchain-openai==0.1.25" \
    "openai==1.109.1" "numpy==1.26.4" \
    "presidio-analyzer>=2.2,<3" "presidio-anonymizer>=2.2,<3" \
    "spacy>=3.7,<3.9" "python-dotenv>=1,<2" "jsonschema>=4.25,<5"
RUN python -m spacy download en_core_web_lg
RUN python -m pip check

# Build with infra/ as context. Source and secrets are supplied only at run time.
WORKDIR /lab
